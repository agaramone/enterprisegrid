{
  "name": "@enterprisegrid/grid",
  "version": "3.0.0",
  "description": "High-performance, feature-rich React data grid with live playground capability.",
  "type": "module",
  "main": "./dist/enterprisegrid.cjs",
  "module": "./dist/enterprisegrid.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/enterprisegrid.mjs",
      "import": "./dist/enterprisegrid.mjs",
      "require": "./dist/enterprisegrid.cjs",
      "default": "./dist/enterprisegrid.mjs"
    },
    "./dist/enterprisegrid.css": "./dist/enterprisegrid.css",
    "./style.css": "./dist/enterprisegrid.css",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "dist",
    "src",
    "assets",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "release": "node scripts/release.js"
  },
  "keywords": [
    "react",
    "data-grid",
    "table",
    "datatable",
    "high-performance",
    "calendar-view",
    "map-view",
    "reorderable",
    "sparklines",
    "heatmaps"
  ],
  "author": "EnterpriseGrid",
  "license": "MIT",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/enterprisegrid"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/enterprisegrid"
    },
    {
      "type": "patreon",
      "url": "https://patreon.com/enterprisegrid"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/enterprisegrid/grid.git"
  },
  "bugs": {
    "url": "https://github.com/enterprisegrid/grid/issues"
  },
  "homepage": "https://github.com/enterprisegrid/grid#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
